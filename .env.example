# Copy to .env and fill in. Never commit .env.
# Instagram (see docs/META_SETUP.md)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Optional
# IG_API_VERSION=v24.0
# IG_TOKEN_STORE=.tokens/token.json

# Only for Facebook-login tokens (EAA…): lets check_token read the expiry and
# token:refresh exchange the token. App settings → Basic in the Meta app dashboard.
# META_APP_ID=
# META_APP_SECRET=
# IG_LOGIN_TYPE=facebook   # normally auto-detected from the token

# Image hosting: Cloudinary free tier (see README → Image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# or instead: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_FOLDER=instagram
# Extra folders upload_image may upload from (comma-separated; out/ is always allowed)
# UPLOAD_ALLOWED_DIRS=

# Card branding (all optional)
# BRAND_HANDLE=@your.handle
# BRAND_PRIMARY=#2E7D5B
# BRAND_ACCENT=#E9964A
# BRAND_HIGHLIGHT=#D0645A
# BRAND_BACKGROUND=#FAF6EF
# BRAND_TEXT=#1E2A26
# BRAND_MUTED=#5E6D66
# BRAND_LOGO=assets/logo.png
# CARD_OUTPUT_DIR=out

# Where the server keeps local data such as follower snapshots (default .data, gitignored)
# INSIGHTS_DATA_DIR=.data

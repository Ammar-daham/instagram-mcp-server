# Copy to .env and fill in. Never commit .env.
# Instagram (see docs/META_SETUP.md)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Optional
# IG_API_VERSION=v24.0
# IG_TOKEN_STORE=.tokens/token.json

# Only for Facebook-login tokens (EAA…): lets check_token read the expiry and
# token:refresh exchange the token. App settings → Basic in the Meta app dashboard.
# META_APP_ID=
# META_APP_SECRET=
# IG_LOGIN_TYPE=facebook   # normally auto-detected from the token
